{
  "name": "page-talk",
  "private": true,
  "version": "0.1.0",
  "description": "页间 · 一个可以画、可以问的 AI PDF 阅读器",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"node --watch server/index.mjs\" \"vite --port 5173\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "sample": "node scripts/make-sample.mjs",
    "check": "tsc --noEmit",
    "tauri:prepare": "node scripts/prepare-tauri.mjs",
    "tauri:build": "npm run build && npm run tauri:prepare && tauri build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "express": "^5.3.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.61.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
